# Copy this file to .env.local once. Day-to-day switching is then controlled
# by PLANPAL_ENV in the command or scripts/run_backend.ps1.
PLANPAL_ENV=local
DEBUG=true
SECRET_KEY=django-insecure-local-planpal-only
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOW_ALL_ORIGINS=true

# Local MySQL
DB_NAME=planpal
DB_USER=root
DB_PASSWORD=replace-with-local-password
DB_HOST=127.0.0.1
DB_PORT=3306

# OAuth public client registered in Django admin
CLIENT_ID=replace-with-local-public-client-id

# Local Redis databases: Celery=0, cache=1, Channels=2
PLANPAL_USE_LOCAL_REDIS_DEFAULTS=true
REQUIRE_EXTERNAL_REDIS=false
USE_REDIS_CACHE=true
USE_REDIS_CHANNELS=true
LOCAL_REDIS_HOST=127.0.0.1
LOCAL_REDIS_PORT=6379
# Leave blank when local Redis has no requirepass. If it has requirepass,
# set only this one value; settings.py builds authenticated URLs for DB 0/1/2.
LOCAL_REDIS_PASSWORD=
# Set only when Redis ACL uses a non-default username.
LOCAL_REDIS_USERNAME=

# OTP is printed in the backend terminal locally unless SMTP is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PlanPal <noreply@planpal.local>
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Optional external integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOONG_API_KEY=
FCM_PROJECT_ID=

ENABLE_API_DOCS=true
API_DOCS_REQUIRE_AUTH=false
LOG_LEVEL=DEBUG
LOG_TO_FILE=false
