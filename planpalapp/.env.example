# Core Django
PLANPAL_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=planpal-backend.fly.dev
CSRF_TRUSTED_ORIGINS=https://planpal-backend.fly.dev,https://planpal.app
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://planpal.app
FRONTEND_ORIGIN=https://planpal.app
DATABASE_URL=mysql://user:password@host:3306/planpal

# OAuth public client registered in Django admin. This is not a client secret.
CLIENT_ID=replace-with-production-public-client-id
WEBSOCKET_TICKET_TTL_SECONDS=45

# Shared managed Redis. Use rediss:// and include the provider password.
# Example: rediss://default:password@redis.example.com:6379/0
REDIS_URL=rediss://default:replace-me@redis.example.com:6379/0
REQUIRE_EXTERNAL_REDIS=true
USE_REDIS_CACHE=true
USE_REDIS_CHANNELS=true
REDIS_HEALTHCHECK_TIMEOUT=2

# Override these only when Celery, cache and Channels use separate instances.
# CELERY_REDIS_URL=rediss://default:password@redis.example.com:6379/0
# CACHE_REDIS_URL=rediss://default:password@redis.example.com:6379/0
# CHANNEL_REDIS_URL=rediss://default:password@redis.example.com:6379/0

# Observability
LOG_LEVEL=INFO
LOG_TO_FILE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# External services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOONG_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_service_account.json
FCM_PROJECT_ID=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PlanPal <noreply@example.com>

# API docs should normally require staff authentication in production.
ENABLE_API_DOCS=true
API_DOCS_REQUIRE_AUTH=true
